{
  "name": "dashr-tool-presentation",
  "description": "Agent-plane presentation plugin for the DASHR RLM runtime: the run_cell transport, Python SDK rendering, and direct-call collapse (blueprint §7.4)",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./py-sdk": {
      "types": "./lib/py-sdk.d.ts",
      "default": "./lib/py-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "preset"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "pretest": "npm run build && npm run --prefix ../dashr build && rm -rf node_modules/dashr-code-runtime-ipython && npm install"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "dashr-code-runtime-ipython": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "dashr-code-runtime-ipython": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    }
  },
