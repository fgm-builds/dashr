{
  "name": "dsh-rlm-mode",
  "description": "RLM Mode for DeepSeek Harness (dsh): one persistent Python kernel per agent session — schema-driven tools.* bindings, sub-agents, harness, and snapshots",
  "version": "0.1.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./py-sdk": {
      "types": "./lib/py-sdk.d.ts",
      "default": "./lib/py-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "preset"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "kernel:venv": "uv venv .venv-kernel --python 3.11 && uv pip install --python .venv-kernel/bin/python ipykernel dill"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zeromq": "^6.6.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
